<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 rescap">

	<Identity
	  Name="AlyssaBaker.PCGuard"
	  Publisher="CN=49EFD5CA-1EBA-4CD4-B9DF-32E520C114CA"
	  Version="1.0.0.0"
	  ProcessorArchitecture="x64" />

	<Properties>
		<DisplayName>PC Guard</DisplayName>
		<PublisherDisplayName>Alyssa Baker</PublisherDisplayName>
		<Logo>Assets\StoreLogo.png</Logo>
	</Properties>

	<Dependencies>
		<TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22631.0" />
	</Dependencies>

	<Resources>
		<Resource Language="en-us" />
	</Resources>

	<Applications>

		<Application Id="PCGuard" Executable="tray_app.exe" EntryPoint="Windows.FullTrustApplication">
			<uap:VisualElements
			  DisplayName="PC Guard"
			  Description="Locks your PC when someone other than you uses it while you are away."
			  BackgroundColor="transparent"
			  Square150x150Logo="Assets\Square150x150Logo.png"
			  Square44x44Logo="Assets\Square44x44Logo.png" />
			<Extensions>
				<uap5:Extension Category="windows.startupTask" Executable="tray_app.exe" EntryPoint="Windows.FullTrustApplication">
					<uap5:StartupTask TaskId="PCGuardStartup" Enabled="true" DisplayName="PC Guard" />
				</uap5:Extension>
			</Extensions>
		</Application>

		<Application Id="PCGuardDashboard" Executable="dashboard.exe" EntryPoint="Windows.FullTrustApplication">
			<uap:VisualElements
			  DisplayName="PC Guard Dashboard"
			  Description="Manage enrolled people, settings, and the PC Guard activity log."
			  BackgroundColor="transparent"
			  Square150x150Logo="Assets\Square150x150Logo.png"
			  Square44x44Logo="Assets\Square44x44Logo.png" />
		</Application>

		<Application Id="PCGuardSetup" Executable="setup_wizard.exe" EntryPoint="Windows.FullTrustApplication">
			<uap:VisualElements
			  DisplayName="PC Guard Setup"
			  Description="Choose a camera and enroll your face."
			  BackgroundColor="transparent"
			  Square150x150Logo="Assets\Square150x150Logo.png"
			  Square44x44Logo="Assets\Square44x44Logo.png" />
		</Application>

	</Applications>

	<Capabilities>
		<rescap:Capability Name="runFullTrust" />
	</Capabilities>

</Package>